# Copy to .env.local for local development. Never commit secrets.
# All variables here are validated by shared/env.ts at boot.

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                  # SERVER-ONLY — never expose

# Postgres connection URLs (server-only).
# Transaction pooler (port 6543) — for app runtime / serverless. Strips
# session features (no LISTEN/NOTIFY, no prepared statements) so it scales
# across cold starts without exhausting Postgres connections.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) — for migrations and the Supabase CLI.
# Required for DDL, advisory locks, and anything needing a session.
SUPABASE_DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ---------- Google Maps Platform ----------
GOOGLE_MAPS_SERVER_KEY=                     # Geocoding + Directions (server-side)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=        # Maps JS API (browser, referrer-restricted)
# Cloud-based Map Style ID. Create a Map Style in Cloud Console (import
# docs/maps/gta-style.json), assign it to a vector Map ID, paste here.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ---------- App ----------
# Local dev: http://localhost:3000 (below). In PRODUCTION this must be
# exactly https://apuhanciftligi.com — no www, no http, no trailing path.
# PayTR's live merchant credentials (see PAYTR_* below) are domain-locked to
# that exact origin; anything else and PayTR rejects the token request with
# "Kullandığınız API bilgileri sadece https://apuhanciftligi.com/ için
# tanımlıdır." next.config.ts permanently redirects www → apex so a customer
# never reaches checkout on the wrong host, and shared/env.ts refuses to
# boot in production if PayTR is enabled and this doesn't match exactly
# (see shared/canonical-origin.ts).
NEXT_PUBLIC_APP_URL=http://localhost:3000
WAREHOUSE_LAT=
WAREHOUSE_LNG=
GEOCODING_DAILY_LIMIT=2000

# ---------- Email (Resend) — storefront order confirmations ----------
# Optional. When unset, the confirmation email is skipped and the order still
# succeeds. EMAIL_FROM must be a Resend-verified sender once the key is set.
RESEND_API_KEY=                             # SERVER-ONLY
EMAIL_FROM=Apuhan Çiftliği <siparis@example.com>

# ---------- Admin notifications ----------
# Optional. Owner's e-mail — receives "yeni sipariş" / "yeni düzenli sipariş
# talebi" notifications. When unset, only the in-panel bell fires (no email).
ADMIN_NOTIFICATION_EMAIL=

# ---------- Payments (PayTR) — storefront card payments ----------
# Optional. When any of the three is unset, the card option is hidden and
# checkout offers only cash-on-delivery / transfer. From the PayTR merchant
# panel. PAYTR_TEST_MODE "1" = test (no real charge), "0" = live.
# PayTR's live credentials are domain-locked in their merchant panel to a
# single exact origin — for this project that's https://apuhanciftligi.com
# (no www). NEXT_PUBLIC_APP_URL must match it exactly in production (see the
# comment above and shared/canonical-origin.ts). PayTR's merchant panel
# notification/callback URL must be set to
# https://apuhanciftligi.com/api/paytr/callback.
PAYTR_MERCHANT_ID=                          # SERVER-ONLY
PAYTR_MERCHANT_KEY=                         # SERVER-ONLY
PAYTR_MERCHANT_SALT=                        # SERVER-ONLY
PAYTR_TEST_MODE=1

# ---------- Observability ----------
SENTRY_DSN=
LOG_LEVEL=info                              # fatal|error|warn|info|debug|trace|silent

# ---------- Defaults ----------
DEFAULT_TIMEZONE=Europe/Istanbul
DEFAULT_CURRENCY=TRY
